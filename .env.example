# =============================================================================
#  Estúdio — configuração das IAs
#  Copie para .env e preencha:   cp .env.example .env
#  O .env é relido a cada pedido (não precisa reiniciar o app) e nunca vai
#  para o git. Não cole chaves em chats nem em commits.
# =============================================================================


# -----------------------------------------------------------------------------
#  CONFIGURAÇÃO DO GEMINI
# -----------------------------------------------------------------------------
#  Todos os agentes (Maestro, Pixel, Chevron, Scout e Revisor) usam o Gemini.
#  Preencha com a sua chave de API (obtida em https://aistudio.google.com/app/apikey).
#  Se deixar a chave vazia, o app tenta usar a CLI logada (`gemini`).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

#  MODO_GRATUITO=true  → força o uso do modelo gratuito do Gemini
MODO_GRATUITO=false
GEMINI_MODELO_GRATUITO=gemini-3.5-flash-lite
